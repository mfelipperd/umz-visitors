# Push notifications (Vercel > Settings > Environment Variables)
# Gerar o par VAPID:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
# Redis (Vercel Marketplace > Upstash Redis preenche estas duas)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Senha do /admin e token da API de envio de avisos (mínimo 24 caracteres): openssl rand -hex 32
ADMIN_TOKEN=
